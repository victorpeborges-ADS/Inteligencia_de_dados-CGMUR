# Homologação local Sinidu+Clima — copie para .env.homolog e ajuste secrets
# Uso: ./scripts/homolog-up.sh .env.homolog

# Auth (false = acesso livre para demo interna)
AUTH_ENABLED=false
MULTI_TENANT_ENABLED=false
AUTH_JWT_SECRET=trocar-em-producao-minimo-32-caracteres
AUTH_ADMIN_PASSWORD=admin
AUTH_GESTOR_PASSWORD=gestor
AUTH_LEITOR_PASSWORD=leitor

# URLs públicas (proxy TLS)
PUBLIC_BASE_URL=https://localhost
NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_INSTITUTIONAL_MODE=true
CORS_ORIGINS=http://localhost:3000,https://localhost
TRUST_PROXY_HEADERS=true

# OIDC Keycloak local (desligado por padrão)
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://host.docker.internal:8080/realms/sinidu
OIDC_CLIENT_ID=sinidu-clima
OIDC_CLIENT_SECRET=sinidu-local-secret-change-me
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT=https://localhost/

# MapBiomas — CSV oficial (opcional, ver brasil.mapbiomas.org/estatisticas)
# MAPBIOMAS_STATS_CSV=/data/mapbiomas/municipios_cobertura.csv
# MAPBIOMAS_STATS_DIR=/data/mapbiomas

# LLM chat + embeddings RAG — somente Mistral
# AI_CHAT_PROVIDER=mistral
# AI_EMBED_PROVIDER=mistral
# AI_ALLOWED_PROVIDERS=mistral
# MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_EMBED_MODEL=mistral-embed
# RAG_EMBEDDING_DIM=1024

# DEM / LiDAR local (GeoTIFF por município em LOCAL_DEM_DIR ou upload via API)
# LOCAL_DEM_DIR=/data/dem/local
# REFINE_PILOT_DEM=true
# OPENTOPOGRAPHY_API_KEY=
# JOB_STORE_REDIS=true
