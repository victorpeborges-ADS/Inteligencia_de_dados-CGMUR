# Sinidu+Clima — variáveis para staging / homologação MCID
# Copie para .env e ajuste antes de subir:
#   cp .env.staging.example .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d

# --- Backend: autenticação ---
AUTH_ENABLED=true
AUTH_JWT_SECRET=trocar-em-producao-minimo-32-caracteres-aleatorios
AUTH_ADMIN_PASSWORD=
AUTH_GESTOR_PASSWORD=
AUTH_LEITOR_PASSWORD=
AUTH_PASSWORD_LOGIN_ENABLED=true

# --- Multi-tenant (Fase 4.3) ---
MULTI_TENANT_ENABLED=true
AUTH_GESTOR_TENANT_UF=PE
AUTH_LEITOR_TENANT_UF=PE
# AUTH_TENANT_gestor_IBGE=2611606,2806701

# --- OIDC / SSO (Fase 4.4) — desligado até credenciais Keycloak/gov.br ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=sinidu-clima
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://sinidu.exemplo.gov.br/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT=https://sinidu.exemplo.gov.br/
OIDC_ADMIN_GROUPS=sinidu-admin
OIDC_GESTOR_GROUPS=sinidu-gestor
OIDC_LEITOR_GROUPS=sinidu-leitor

# --- Proxy / URLs públicas (Fase 4.5) ---
PUBLIC_BASE_URL=https://sinidu.exemplo.gov.br
NEXT_PUBLIC_API_URL=https://sinidu.exemplo.gov.br
CORS_ORIGINS=https://sinidu.exemplo.gov.br
TRUST_PROXY_HEADERS=true
PROXY_HTTP_PORT=80

# --- Integrações opcionais ---
# GEMINI_API_KEY=
# GOOGLE_MAPS_API_KEY=
