# Sinidu+Clima — produção MCID
# cp .env.production.example .env && editar secrets/URLs
# Coloque certificado institucional em deploy/nginx/certs/{fullchain,privkey}.pem
# ./scripts/prod-up.sh .env

# --- Domínio público ---
PUBLIC_BASE_URL=https://sinidu.cidades.gov.br
NEXT_PUBLIC_API_URL=https://sinidu.cidades.gov.br
CORS_ORIGINS=https://sinidu.cidades.gov.br
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
TLS_CERT_DIR=./deploy/nginx/certs

# --- Auth (obrigatório em produção) ---
AUTH_ENABLED=true
AUTH_JWT_SECRET=GERAR-SECRET-ALEATORIO-MIN-32-CHARS
AUTH_ADMIN_PASSWORD=
AUTH_GESTOR_PASSWORD=
AUTH_LEITOR_PASSWORD=
AUTH_PASSWORD_LOGIN_ENABLED=false

# --- Multi-tenant ---
MULTI_TENANT_ENABLED=true
AUTH_GESTOR_TENANT_UF=
AUTH_LEITOR_TENANT_UF=

# --- OIDC gov.br / Keycloak MCID ---
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://keycloak.cidades.gov.br/realms/mcid
OIDC_CLIENT_ID=sinidu-clima
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://sinidu.cidades.gov.br/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT=https://sinidu.cidades.gov.br/
OIDC_ADMIN_GROUPS=sinidu-admin
OIDC_GESTOR_GROUPS=sinidu-gestor
OIDC_LEITOR_GROUPS=sinidu-leitor

# --- MapBiomas CSV oficial (recomendado) ---
# MAPBIOMAS_STATS_CSV=/data/mapbiomas/municipios_cobertura.csv

# --- Integrações opcionais ---
# GEMINI_API_KEY=
# GOOGLE_MAPS_API_KEY=
