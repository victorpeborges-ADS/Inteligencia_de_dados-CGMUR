# OIDC gov.br / Keycloak MCID — copie variáveis para .env de produção
# Documentação: https://www.gov.br/governodigital/pt-br/identidade

OIDC_ENABLED=true
OIDC_ISSUER_URL=https://sso.staging.acesso.gov.br/.well-known/openid-configuration
# Produção gov.br (exemplo — confirmar URL vigente com CGU/DTI):
# OIDC_ISSUER_URL=https://sso.acesso.gov.br

OIDC_CLIENT_ID=sinidu-clima.mcid.gov.br
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email govbr_confiabilidades
OIDC_REDIRECT_URI=https://sinidu.cidades.gov.br/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT=https://sinidu.cidades.gov.br/

# Mapeamento de roles (grupos Keycloak ou resource_access)
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_GROUPS=sinidu-admin,admin,ROLE_SINIDU_ADMIN
OIDC_GESTOR_GROUPS=sinidu-gestor,gestor_municipal,ROLE_SINIDU_GESTOR
OIDC_LEITOR_GROUPS=sinidu-leitor,leitor,ROLE_SINIDU_LEITOR

# Multi-tenant via claims do IdP
OIDC_TENANT_UF_CLAIM=tenant_uf
OIDC_TENANT_IBGE_CLAIM=tenant_ibge

AUTH_PASSWORD_LOGIN_ENABLED=false
